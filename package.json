{
  "name": "react-admin-framework",
  "version": "1.0.0",
  "private": true,
  "description": "React / Umi / Ant Design 通用管理端框架",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "umi dev",
    "start": "umi dev",
    "build": "umi build",
    "build:staging": "cross-env UMI_ENV=staging umi build",
    "postinstall": "umi setup",
    "lint": "eslint src --ext .js,.jsx --max-warnings=0",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "verify": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "umi": "^4.1.0",
    "antd": "^5.11.5",
    "@ant-design/icons": "^5.2.6",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-react": "^1.0.6",
    "ahooks": "^3.7.8",
    "axios": "^1.6.2",
    "dayjs": "^1.11.10",
    "js-cookie": "^3.0.5",
    "nprogress": "^0.2.0",
    "fuse.js": "^7.1.0",
    "pinyin-match": "^1.2.10",
    "react-router-dom": "6.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@umijs/plugins": "^4.1.0",
    "babel-jest": "^29.7.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2"
  }
}
